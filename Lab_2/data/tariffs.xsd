<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

    <xs:simpleType name="TariffIdType">
        <xs:restriction base="xs:ID">
            <xs:pattern value="T\d{3}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NonEmptyStringType">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="100"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="MoneyType">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0"/>
            <xs:fractionDigits value="2"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="FavoriteNumbersType">
        <xs:restriction base="xs:nonNegativeInteger"/>
    </xs:simpleType>

    <xs:simpleType name="TarificationType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="12-second"/>
            <xs:enumeration value="per-minute"/>
        </xs:restriction>
    </xs:simpleType>



    <xs:complexType name="CallPricesType">
        <xs:sequence>
            <xs:element name="InsideNetwork" type="MoneyType"/>
            <xs:element name="OutsideNetwork" type="MoneyType"/>
            <xs:element name="Landline" type="MoneyType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ParametersType">
        <xs:sequence>
            <xs:element name="FavoriteNumber" type="FavoriteNumbersType"/>
            <xs:element name="Tarification" type="TarificationType"/>
            <xs:element name="ConnectionFee" type="MoneyType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="TariffType">
        <xs:sequence>
            <xs:element name="Name" type="NonEmptyStringType"/>
            <xs:element name="OperatorName" type="NonEmptyStringType"/>
            <xs:element name="Payroll" type="MoneyType"/>
            <xs:element name="CallPrices" type="CallPricesType"/>
            <xs:element name="SmsPrice" type="MoneyType"/>
            <xs:element name="Parameters" type="ParametersType"/>
        </xs:sequence>
        <xs:attribute name="id" type="TariffIdType" use="required"/>
    </xs:complexType>



    <xs:element name="Tariffs">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Tariff" type="TariffType" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
